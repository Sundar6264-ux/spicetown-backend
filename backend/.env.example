# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./spicetown.db

# --- Toast API (Orders API + Purchasing & Receiving API) ---
# Standard API Access credentials from the Toast dev portal.
TOAST_API_BASE=https://ws-api.toasttab.com
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# --- Sales cron job ---
# Hour (0-23, in TOAST_TIMEZONE) the daily sales sync runs at.
SALES_SYNC_HOUR=4
SALES_SYNC_MINUTE=0
# IANA timezone the restaurant's "business date" is anchored to.
# Spice Town (Vernon, CT) is America/New_York, confirmed via
# GET /restaurants/v1/restaurants/{guid} -> general.timeZone.
TOAST_TIMEZONE=America/New_York
# How many trailing days the sync checks each run for gaps and backfills automatically
# (e.g. the service was down overnight for any reason).
SALES_SYNC_BACKFILL_DAYS=14

# --- CORS ---
# Comma-separated list of origins allowed to call this API (the React dev server / deployed frontend).
CORS_ORIGINS=http://localhost:5173

# --- Ask Inventory Bot (Claude API) ---
# From console.anthropic.com. Powers the natural-language query page - read-only,
# never used to write data. Without this set, that page returns a clear error
# telling you it's not configured; nothing else in the app depends on it.
ANTHROPIC_API_KEY=
